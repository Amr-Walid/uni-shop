<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8.0+). The launcher masks these two layers into
     whatever shape the device theme uses — circle, squircle, rounded square —
     so the artwork must not be pre-masked. Older releases fall back to the
     legacy bitmap in mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
